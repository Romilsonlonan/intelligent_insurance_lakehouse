# ── Google AI (Gemma / Gemini) ────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemma-3-27b-it
GOOGLE_EMBEDDING_MODEL=models/embedding-001

# ── API ───────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Neo4j (Knowledge Graph) ───────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=prudential123

# ── ChromaDB (Vector Store) ───────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=prudential_rag

# ── Data paths ────────────────────────────────────────────────
DATA_BRONZE_PATH=./data/bronze
DATA_SILVER_PATH=./data/silver
DATA_GOLD_PATH=./data/gold

# ── Human-in-the-loop ─────────────────────────────────────────
HITL_AUTO_APPROVE=false
HITL_TIMEOUT_SECONDS=300

# ── MinIO (Object Storage) ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=lakehouse-data
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
